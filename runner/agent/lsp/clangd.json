{
  "clangd": {
    "command": ["clangd", "--background-index=false", "--pch-storage=memory", "--malloc-trim", "-j=2",
                "--limit-results=500", "--header-insertion-decorators=false",
                "--query-driver=/usr/local/bin/*,/usr/bin/*", "--log=error"],
    "env": {"XDG_CONFIG_HOME": "/opt/lsp/clangd/xdg"}
  }
}
