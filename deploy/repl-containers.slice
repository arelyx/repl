# Parent cgroup for every repl container (backend passes
# cgroup_parent=repl-containers.slice). Whatever users run, repls as a whole
# cannot take more than these limits, so nginx, the backend, postgres and the
# OS keep their share. Sized by deploy/install-host.sh from the host's cores
# and RAM; the numbers below are this host's (32 cores, 29 GB).
[Unit]
Description=Repl user containers
Before=slices.target

[Slice]
CPUAccounting=yes
CPUQuota=2800%
# Half the weight of system.slice (where every other service's containers
# run), so under contention repls yield first.
CPUWeight=50
MemoryAccounting=yes
MemoryMax=20G
MemoryHigh=19G
MemorySwapMax=0
TasksMax=30000
IOAccounting=yes
IOWeight=50
