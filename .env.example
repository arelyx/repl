# Copy to .env and fill in. The backend refuses to start while JWT_SECRET_KEY
# or INTERNAL_SECRET is a placeholder or shorter than 32 characters, or (when
# APP_ENV=production) POSTGRES_PASSWORD is a placeholder.
# Generate each secret with:  openssl rand -hex 32

# ---- Database ----
POSTGRES_USER=repl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repl

# ---- Secrets (>= 32 chars, random) ----
JWT_SECRET_KEY=change-me
INTERNAL_SECRET=change-me-too

# ---- Paths and hosts ----
# Absolute host path where repl working trees live (bind-mounted at the same path in backend)
REPLS_HOST_DIR=/absolute/path/to/replit_clone/data/repls
# Public host[:port] the app is served on
PUBLIC_HOST=localhost:8380
# http or https. https makes the auth cookie Secure and named __Host-access_token,
# and preview URLs https://<id>-<port>.preview.<PREVIEW_HOST>.
PUBLIC_SCHEME=http
# Host previews hang off (<id>-<port>.preview.<PREVIEW_HOST>). Empty = PUBLIC_HOST.
# On a public server use a separate registrable domain (e.g. app on repl.example,
# previews on repl-preview.example) so preview pages are cross-site to the app.
PREVIEW_HOST=
# Host port nginx listens on (bound to 127.0.0.1; put a TLS proxy in front)
HTTP_PORT=8380

# ---- App behaviour ----
# production | development (development serves /api/v1/docs and skips the
# database password check)
APP_ENV=production
# Empty = follow PUBLIC_SCHEME (Secure under https). true/false to force.
COOKIE_SECURE=
# Login lifetime in days. Logout and password changes revoke all of a user's tokens.
JWT_EXPIRE_DAYS=7
# Extra origins (comma-separated) allowed to call the API with cookies.
# Leave empty: the frontend is served same-origin by nginx.
CORS_ORIGINS=
# false = only existing users can log in; /auth/register returns 403
ALLOW_SIGNUP=true
# Peers whose X-Forwarded-For is trusted for the client IP (rate limits).
# Hostnames or CIDRs, comma-separated. repl-nginx already resolves the real
# client from a host TLS proxy (Caddy) in front of it (set_real_ip_from), so
# the default is right for that setup too.
TRUSTED_PROXIES=repl-nginx

# ---- Auth rate limits (in memory, per backend process) ----
# login + register attempts per client IP per minute
AUTH_RATE_PER_MIN=10
# sign-ups per client IP per hour
REGISTER_RATE_PER_HOUR=5
# failed logins per account ...
LOGIN_MAX_FAILURES=5
# ... per this many minutes, then 429 until the window passes
LOGIN_FAILURE_WINDOW_MIN=15

# ---- API resource caps ----
# create/fork refused with 403 beyond this
MAX_REPLS_PER_USER=50
# file reads (editor + collaboration) -> 413 above this
MAX_FILE_READ_MB=10
# single upload -> 413 above this
MAX_UPLOAD_MB=50
# uncompressed size of a zip download -> 413 above this
MAX_ZIP_MB=500
# git diff/show responses are truncated past this
MAX_GIT_OUTPUT_MB=2
# Previews behind Caddy's on-demand TLS get one certificate per hostname.
# New hostnames per 7 days the backend lets Caddy request (Let's Encrypt
# allows 50 per registered domain per week, shared with your other sites).
# -1 = unlimited, for a wildcard certificate (DNS-01) or a CA without limits.
PREVIEW_CERTS_PER_WEEK=30

# ---- Repl runtime ----
IDLE_TIMEOUT_MINUTES=30
RUNNER_IMAGE=repl-polyglot:latest
# Container runtime for repls; "runsc" (gVisor) is strongly recommended on a public server
REPL_RUNTIME=runsc
# CPUs per repl container
REPL_CPUS=1
# memory per repl container
REPL_MEMORY=2g
# process limit per repl container
REPL_PIDS=2048
# resolvers for repls (gVisor can't reach Docker's embedded DNS); empty = Docker's
REPL_DNS=1.1.1.1,8.8.8.8
# optional parent cgroup capping all repls together
REPL_CGROUP_PARENT=repl-containers.slice
# running repls per user
MAX_RUNNING_PER_USER=2
# running repls on the whole server
MAX_RUNNING_REPLS=20
# per-repl disk quota (uploads, forks, reaper)
REPL_DISK_QUOTA_MB=2048
# hard cap on a container's lifetime
MAX_CONTAINER_HOURS=12
# Only for hosts without gVisor (development). Repls on runc share the host kernel.
ALLOW_INSECURE_RUNTIME=false
